  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.1",
    "@ai-sdk/google": "^3.0.1",
    "@ai-sdk/openai": "^3.0.1",
    "@types/prompts": "^2.4.9",
    "ai": "^6.0.3",
    "commander": "^14.0.2",
    "marked": "^17.0.1",
    "marked-terminal": "^7.3.0",
    "ollama-ai-provider": "^1.2.0",
    "omelette": "^0.4.17",
    "prompts": "^2.4.2",
    "yaml": "^2.8.2"
  }
